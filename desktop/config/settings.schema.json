{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/war-room-desktop/settings-v1.json",
  "title": "Aftergraph War Room Desktop settings payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["githubOrg", "refreshSeconds", "workflowRepoCap", "probes", "typeSafeAuto", "typeSafeMinIntervalSec", "typeSafeDailyBudget", "worksEnabled", "agentStaleSeconds", "assistantLocalModel", "assistantOllamaUrl"],
  "properties": {
    "githubOrg": {"type": "string", "minLength": 1},
    "refreshSeconds": {"type": "integer", "minimum": 60},
    "workflowRepoCap": {"type": "integer", "minimum": 1, "maximum": 60},
    "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
    "repoDomains": {"type": "object", "additionalProperties": {"type": "string"}},
    "typeSafeAuto": {"type": "boolean"},
    "typeSafeMinIntervalSec": {"type": "integer", "minimum": 60},
    "typeSafeDailyBudget": {"type": "integer", "minimum": 1, "maximum": 1000},
    "worksEnabled": {"type": "boolean"},
    "worksUrl": {"type": "string"},
    "agentStaleSeconds": {"type": "integer", "minimum": 15, "maximum": 3600},
    "assistantLocalModel": {"type": "boolean"},
    "assistantOllamaUrl": {"type": "string"},
    "assistantModel": {"type": "string"}
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "domain", "enabled"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "domain": {"type": "string"},
        "enabled": {"type": "boolean"}
      }
    }
  }
}
